{
  "name": "reactbits-local",
  "private": true,
  "description": "ReactBits 本地资产库：139 个组件源码 + prompt 镜像 + 可视化选型台",
  "scripts": {
    "dev": "vite --port ${PORT:-5180}",
    "build": "vite build",
    "sync": "node scripts/fetch-repo.mjs && node scripts/build-prompts.mjs",
    "check:deps": "node scripts/check-deps.mjs",
    "check:controls": "node scripts/audit-controls.mjs",
    "verify:site": "node scripts/verify-against-site.mjs",
    "verify:playground": "node scripts/verify-playground.mjs",
    "verify:remount": "node scripts/verify-remount.mjs",
    "sweep": "node scripts/sweep-all.mjs --shots",
    "sweep:offline": "node scripts/sweep-all.mjs --offline --shots",
    "check:blank": "node scripts/detect-blank.mjs",
    "check:network": "node scripts/check-network.mjs",
    "doctor": "node scripts/doctor.mjs",
    "postinstall": "node -e \"console.log('\\n选型台依赖已装。取用组件其实不需要这些 —— node scripts/add.mjs --list 直接可用\\n')\"",
    "test": "node scripts/ci-smoke.mjs"
  },
  "dependencies": {
    "@babel/parser": "^8.0.4",
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.0.4",
    "@react-three/rapier": "^2.2.0",
    "@use-gesture/react": "^10.3.1",
    "face-api.js": "^0.22.2",
    "gl-matrix": "^3.4.4",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "lucide-react": "^0.542.0",
    "maath": "^0.10.8",
    "mathjs": "^14.9.1",
    "matter-js": "^0.20.0",
    "meshline": "^3.3.1",
    "motion": "^12.43.0",
    "ogl": "^1.0.11",
    "postprocessing": "^6.39.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-router-dom": "^6.30.4",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  }
}